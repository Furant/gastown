# Local development: npm run dev. Only binds loopback by default.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8770
CONSOLE_DATA_DIR=.data

# Production: set DATABASE_URL to your PostgreSQL instance, e.g. a local secret.
# DATABASE_URL=postgresql://console:<generated-password>@localhost:5432/console
# Set these for docker compose, using the same newly generated password.
# POSTGRES_PASSWORD=
# COOKIE_SECURE=1
